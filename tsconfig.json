{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "@playwright/test"]
  },
  "include": ["test/**/*", "playwright.config.ts", "vitest.config.ts", "main/**/*"]
}